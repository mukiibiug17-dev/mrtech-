{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mrtech",
  "main": "worker.js",
  "compatibility_date": "2026-10-06",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "MODEL": "claude-haiku-5-5",
    "DAILY_LIMIT": "200"
  }
}
